{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview-window",
  "description": "预览窗口权限",
  "windows": [
    "preview-window"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}

